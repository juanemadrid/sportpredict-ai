# =============================================================================
# SPORTPREDICT AI - VARIABLES DE ENTORNO (DESARROLLO LOCAL)
# =============================================================================

# Entorno: development | test | production
ENVIRONMENT=development

# Si se deja vacío en desarrollo, utiliza SQLite local aislado en backend/data/sportpredict_local.db
DATABASE_URL=

# Supabase Auth
# En desarrollo es opcional (permite simular roles con cabeceras de depuración).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Correos con rol ADMIN asignado automáticamente (separados por coma)
ADMIN_EMAILS=admin@sportpredict.ai

# Permitir cabeceras de depuración (X-User-Role / X-User-Plan) SOLO en desarrollo
AUTH_ALLOW_DEV_HEADERS=true

# API-Football (v3.football.api-sports.io)
# Si está vacío, opera en estado NOT_CONFIGURED sin simular llamadas
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=100

# Puertos y URLs
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Semilla de datos demostrativos (solo desarrollo)
SEED_DEMO_DATA=true
