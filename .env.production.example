# =============================================================================
# SPORTPREDICT AI - VARIABLES DE ENTORNO (PRODUCCIÓN)
# =============================================================================

# Entorno mandatorio
ENVIRONMENT=production

# Base de datos PostgreSQL (Supabase o Postgres dedicado con pool de conexiones)
# Ej: postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASEÑA@db.tu-supabase-ref.supabase.co:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Supabase Auth
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-real
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-real

# Emails con rol ADMIN garantizado en primer login (separados por coma)
ADMIN_EMAILS=fundador@tudominio.com,admin@tudominio.com

# En producción las cabeceras de simulación están estrictamente desactivadas
AUTH_ALLOW_DEV_HEADERS=false

# Configuración HTTP y Seguridad
CORS_ORIGINS=https://tu-dominio.com,https://app.tu-dominio.com
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://api.tu-dominio.com
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-real

# Límites de tasa por IP y proxy reverso (Nginx, Traefik, Cloudflare)
RATE_LIMIT_PER_MINUTE=120
TRUSTED_PROXY_HEADERS=true
ENABLE_API_DOCS=false

# Observabilidad
LOG_LEVEL=INFO
LOG_JSON=true

# Planificador y ciclo de Fase 5
SCHEDULER_INTERVAL_MINUTES=360
PROSPECTIVE_REGISTER_HORIZON_HOURS=48

# API-Football (v3.football.api-sports.io)
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=100

# Desactivar semillas de prueba en producción
SEED_DEMO_DATA=false
